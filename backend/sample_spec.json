{
  "openapi": "3.0.3",
  "info": {
    "title": "Vulnerable Pet Store API",
    "description": "A deliberately vulnerable API for testing SentinelAI security scanner.",
    "version": "1.0.0"
  },
  "paths": {
    "/pets": {
      "get": {
        "operationId": "listPets",
        "summary": "List all pets",
        "tags": ["pets"],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": { "description": "A list of pets" }
        }
      },
      "post": {
        "operationId": "createPet",
        "summary": "Create a pet",
        "tags": ["pets"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "breed": { "type": "string" },
                  "price": { "type": "number" },
                  "admin_override_price": { "type": "number" },
                  "internal_note": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Pet created" }
        }
      }
    },
    "/pets/{petId}": {
      "get": {
        "operationId": "getPet",
        "summary": "Get a pet by ID",
        "tags": ["pets"],
        "parameters": [
          {
            "name": "petId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "A pet" }
        }
      },
      "put": {
        "operationId": "updatePet",
        "summary": "Update a pet",
        "tags": ["pets"],
        "parameters": [
          {
            "name": "petId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "price": { "type": "number" },
                  "role": { "type": "string" },
                  "is_admin": { "type": "boolean" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Pet updated" }
        }
      },
      "delete": {
        "operationId": "deletePet",
        "summary": "Delete a pet",
        "tags": ["pets"],
        "parameters": [
          {
            "name": "petId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "204": { "description": "Pet deleted" }
        }
      }
    },
    "/pets/{petId}/toys": {
      "get": {
        "operationId": "listToys",
        "summary": "List toys for a pet",
        "tags": ["toys"],
        "parameters": [
          {
            "name": "petId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "A list of toys" }
        }
      }
    },
    "/store/orders": {
      "post": {
        "operationId": "placeOrder",
        "summary": "Place a store order",
        "tags": ["store"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "petId": { "type": "string" },
                  "quantity": { "type": "integer" },
                  "webhook_url": { "type": "string", "format": "uri" },
                  "callback_url": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Order placed" }
        }
      }
    },
    "/users": {
      "post": {
        "operationId": "createUser",
        "summary": "Create a new user",
        "tags": ["users"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "username": { "type": "string" },
                  "password": { "type": "string" },
                  "email": { "type": "string" },
                  "api_key": { "type": "string" },
                  "admin_token": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "User created" }
        }
      }
    },
    "/users/login": {
      "post": {
        "operationId": "loginUser",
        "summary": "User login",
        "tags": ["users"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "username": { "type": "string" },
                  "password": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Login successful" }
        }
      }
    },
    "/admin/users": {
      "get": {
        "operationId": "adminListUsers",
        "summary": "Admin: list all users",
        "tags": ["admin"],
        "responses": {
          "200": { "description": "List of all users" }
        }
      },
      "delete": {
        "operationId": "adminDeleteUser",
        "summary": "Admin: delete a user",
        "tags": ["admin"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "userId": { "type": "integer" }
                }
              }
            }
          }
        },
        "responses": {
          "204": { "description": "User deleted" }
        }
      }
    },
    "/admin/config": {
      "get": {
        "operationId": "adminGetConfig",
        "summary": "Admin: get system config",
        "tags": ["admin"],
        "responses": {
          "200": { "description": "System configuration" }
        }
      }
    },
    "/internal/debug": {
      "get": {
        "operationId": "debugInfo",
        "summary": "Debug endpoint",
        "tags": ["internal"],
        "deprecated": true,
        "responses": {
          "200": { "description": "Debug information" }
        }
      }
    },
    "/webhook/register": {
      "post": {
        "operationId": "registerWebhook",
        "summary": "Register a webhook URL",
        "tags": ["webhooks"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "target_url": { "type": "string", "format": "uri" },
                  "event": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Webhook registered" }
        }
      }
    },
    "/health": {
      "get": {
        "operationId": "healthCheck",
        "summary": "Health check",
        "tags": ["system"],
        "responses": {
          "200": { "description": "Service is healthy" }
        }
      }
    }
  }
}

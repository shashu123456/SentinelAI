{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://sentinelai-backend.onrender.com/api/:path*"
    },
    {
      "source": "/ws/:path*",
      "destination": "wss://sentinelai-backend.onrender.com/ws/:path*"
    },
    {
      "source": "/docs",
      "destination": "https://sentinelai-backend.onrender.com/docs"
    },
    {
      "source": "/redoc",
      "destination": "https://sentinelai-backend.onrender.com/redoc"
    },
    {
      "source": "/openapi.json",
      "destination": "https://sentinelai-backend.onrender.com/openapi.json"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,POST,PUT,DELETE,PATCH,OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Authorization,Content-Type" }
      ]
    }
  ]
}

{
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build:static",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/dashboard",
      "destination": "/index.html"
    },
    {
      "source": "/new-scan",
      "destination": "/index.html"
    },
    {
      "source": "/scan/:id",
      "destination": "/index.html"
    },
    {
      "source": "/live/:taskId",
      "destination": "/index.html"
    },
    {
      "source": "/sast",
      "destination": "/index.html"
    },
    {
      "source": "/deps",
      "destination": "/index.html"
    },
    {
      "source": "/copilot",
      "destination": "/index.html"
    },
    {
      "source": "/login",
      "destination": "/index.html"
    }
  ]
}
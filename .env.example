# ═══════════════════════════════════════════════════════════════════
# SentinelAI — Environment Variables
# ═══════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ═══════════════════════════════════════════════════════════════════

# ── Application ────────────────────────────────────────────────────
SENTINEL_ENV=production
SENTINEL_VERSION=1.0.0

# ── Security (CRITICAL — change before deployment) ─────────────────
SECRET_KEY=generate-a-random-64-char-string-here
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"

# ── Database ───────────────────────────────────────────────────────
POSTGRES_DB=sentinelai
POSTGRES_USER=sentinelai
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://sentinelai:${POSTGRES_PASSWORD}@postgres:5432/sentinelai

# ── Redis ──────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
REDIS_PORT=6379

# ── Backend ────────────────────────────────────────────────────────
BACKEND_PORT=8000
CORS_ORIGINS=["http://localhost","http://localhost:80","http://localhost:3000"]

# ── Authentication ─────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
RATE_LIMIT_PER_MINUTE=60

# ── AI (Ollama) ────────────────────────────────────────────────────
OLLAMA_MODEL=mistral

# ── Email (optional — for password reset) ──────────────────────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=noreply@yourdomain.com

# ── Error Tracking (Sentry — optional) ─────────────────────────────
# SENTRY_DSN=https://your-dsn@sentry.io/project-id
# SENTRY_TRACES_SAMPLE_RATE=0.1

# ── Ports ──────────────────────────────────────────────────────────
FRONTEND_PORT=80
POSTGRES_PORT=5432
REDIS_PORT=6379
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
OLLAMA_PORT=11434

# ── Grafana ────────────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=change-me
